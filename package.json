{
  "name": "sprinthub",
  "version": "1.0.0",
  "description": "A modern full-stack project management platform inspired by Jira, Trello, and ClickUp.",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "start": "npm run start:web",
    "start:api": "npm run start --workspace=api",
    "start:web": "npm run start --workspace=web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:api": "npm run lint --workspace=api",
    "lint:fix:api": "npm run lint:fix --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "lint:fix:web": "npm run lint:fix --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:api": "npm run typecheck --workspace=api",
    "typecheck:web": "npm run typecheck --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test:integration": "npm run test:integration --workspace=api",
    "test:e2e": "npm run test:e2e --workspace=web",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace=api",
    "db:seed": "npm run prisma:seed --workspace=api",
    "db:studio": "npm run prisma:studio --workspace=api",
    "db:generate": "npm run prisma:generate --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "prisma:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=api",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "prisma:studio": "npm run prisma:studio --workspace=api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build",
    "docker:db": "docker compose up -d postgres",
    "docker:build:prod": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docs:validate": "npm run docs:validate --workspace=api",
    "docs:generate": "npm run docs:generate --workspace=api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasdev97/sprinthub.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nicolasdev97/sprinthub/issues"
  },
  "homepage": "https://github.com/nicolasdev97/sprinthub#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  }
}
