# ==============================================================================
# SprintHub - Root / Docker Compose Environment Variables
# ==============================================================================
# This file serves as a template for configuring Docker Compose services.
# Copy this file to `.env` in the root directory for local container orchestration:
#   cp .env.example .env
# ==============================================================================

# Database Service Configuration (PostgreSQL 17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sprinthub
POSTGRES_PORT=5432

# Backend API Configuration
API_PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-key-at-least-32-chars

# Frontend Web Client Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

