# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sprinthub"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key"
JWT_REFRESH_SECRET="super-refresh-secret-key"

# Backend Api
PORT=3001
NODE_ENV=development

# Client Frontend (CORS)
# Supports comma-separated list of origins: http://localhost:3000,https://app.sprinthub.com
CLIENT_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
