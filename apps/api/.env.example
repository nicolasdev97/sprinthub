# ==============================================================================
# SprintHub API (Backend) - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` inside `apps/api/` for local backend development:
#   cp .env.example .env
# ==============================================================================

# Database Connection (Prisma ORM with PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sprinthub?schema=public"

# Server Port and Runtime Environment
PORT=3001
NODE_ENV=development

# JWT Authentication Secrets
# In production, generate cryptographically random 256-bit keys (e.g., `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-key-at-least-32-chars"

# Allowed CORS Origins
# Supports comma-separated list of origins for local frontend clients
CORS_ORIGIN="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
